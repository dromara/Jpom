# ===== 本地开发/测试脚本（不要提交）=====
# E2E / 调试 / 审计类脚本绑定本机环境与内网信息，一律不进开源仓；需要时放在仓库外自用
/e2e-*.sh
/dbg-*.sh
/audit_*.py

# ===== 本地临时产物 / AI 调试目录（不要提交）=====
# 临时产物可随时删除；需要长期留存的开发文档请放到独立私有文档库（不随本仓提交）
/.tmp/

# ===== go-agent 黄金响应样本（私有测试资料，不入公开仓）=====
# 采集设备真实响应并脱敏得到的样本仍含主机/路径/版本等环境指纹，不入公开仓；
# 需要时放在仓库外，用 JPOM_GOLDEN_DIR 指向该目录；包内 testdata/golden 同样不入库
**/internal/sysinfo/testdata/golden/
# 仓库内只保留纯合成夹具：internal/builder/testdata 的 AntPath parity 基线、
# internal/projectfile/testdata 的 7z 穿越/符号链接安全用例。
/go-agent/testdata/
**/testdata/raw/
go-agent-ref/

# ===== 密钥 / 证书 / 本地凭据（开源仓库禁止提交）=====
# 提交前请同时运行：bash script/check-sensitive.sh --all
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.env.local
.env.*.local

# mcp-server 是独立 npm 包，需要提交 lockfile 供 CI 使用 npm ci
!mcp-server/package-lock.json
